.intro {
  display: flex;
  flex-direction: column;
}

.intro-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.intro-text {
  color: #747d8c;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-card {
  margin-top: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.picker-value {
  padding: 16rpx 20rpx;
  background: #f5f6f8;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-value.placeholder {
  color: #a4b0be;
}

.hint {
  margin-top: 8rpx;
  color: #a4b0be;
  font-size: 24rpx;
}

.current-text {
  margin-bottom: 16rpx;
  color: #2f9e44;
  font-size: 26rpx;
}

.save-btn {
  margin-top: 8rpx;
}

/* 桌宠配对码（C9 跨端一致） */
.pairing-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pairing-code {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #eefaf1;
  border: 1rpx solid #bfe8cc;
  border-radius: 8rpx;
  color: #2f9e44;
  font-size: 28rpx;
  word-break: break-all;
}
