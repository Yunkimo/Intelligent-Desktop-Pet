<view class="page">
  <view class="week-bar">
    <text class="week-label">本周</text>
    <view class="week-value">{{todayLabel || '--'}}</view>
    <text class="week-hint" bindtap="openSemester">设置</text>
  </view>

  <view wx:if="{{offline}}" class="offline-banner">当前离线：周次按本机日期推算，课程列表暂不可用</view>

  <view wx:if="{{needSetup}}" class="setup-card card">
    <view class="setup-text">尚未设置学期，无法计算本周周次</view>
    <button class="btn btn-primary" bindtap="openSemester">去设置学期</button>
  </view>

  <view wx:if="{{statusText}}" class="status-banner">当前状态：{{statusText}}</view>

  <view wx:if="{{error}}" class="error-banner">
    <text>{{error}}</text>
    <text class="retry" bindtap="retry">重试</text>
  </view>

  <!-- 明日带伞提示卡片 -->
  <view class="card weather-card">
    <view class="weather-head">
      <view class="weather-title">
        <text class="weather-city" bindtap="openCityPicker">{{weatherCity}} ▾</text>
        <text class="weather-date">{{weatherDateLabel}}</text>
      </view>
      <text wx:if="{{weatherUpdated}}" class="weather-updated">更新 {{weatherUpdated}}</text>
    </view>
    <view class="weather-headline {{weatherUnknown ? 'weather-muted' : (weatherText.headline.indexOf('降水') >= 0 ? 'weather-rain' : '')}}">
      {{weatherText.headline || '加载中…'}}
    </view>
    <view wx:if="{{weatherText.sub}}" class="weather-sub">{{weatherText.sub}}</view>
    <view class="weather-actions">
      <text wx:if="{{weatherUnknown}}" class="weather-retry" bindtap="retryWeather">重试</text>
      <text wx:if="{{weatherSubText}}" class="weather-sub-status" bindtap="openWeatherDetail">订阅：{{weatherSubText}} ›</text>
      <button wx:if="{{!weatherSub || weatherSub.status === 'prepared' || weatherSub.status === 'rejected' || weatherSub.status === 'cancelled'}}"
        class="btn btn-subscribe mini" disabled="{{weatherBusy}}" loading="{{weatherBusy}}" bindtap="onSubscribeWeather">订阅带伞提醒</button>
      <button wx:if="{{weatherSub && (weatherSub.status === 'pending' || weatherSub.status === 'checking' || weatherSub.status === 'retry_weather' || weatherSub.status === 'retry')}}"
        class="btn btn-ghost mini" disabled="{{weatherBusy}}" bindtap="cancelWeatherSub">取消订阅</button>
      <button wx:if="{{weatherSub && (weatherSub.status === 'sent' || weatherSub.status === 'no_rain' || weatherSub.status === 'failed' || weatherSub.status === 'uncertain' || weatherSub.status === 'expired')}}"
        class="btn btn-ghost mini" bindtap="openWeatherDetail">查看详情</button>
    </view>
    <view class="weather-note">订阅今晚 21:00 的{{weatherCity}}带伞提醒，仅明天有降水时发送（每次订阅仅本次有效）</view>
  </view>

  <!-- 城市选择 -->
  <view wx:if="{{showCityPicker}}" class="mask">
    <view class="modal">
      <view class="modal-title">选择城市</view>
      <view class="city-chips">
        <text wx:for="{{commonCities}}" wx:key="*this" class="city-chip" data-city="{{item}}" bindtap="pickCity">{{item}}</text>
      </view>
      <view class="form-item">
        <input class="input" value="{{cityInput}}" bindinput="onCityInput" placeholder="或输入其他城市名" maxlength="40" />
      </view>
      <view class="modal-actions">
        <button class="btn btn-ghost" bindtap="closeCityPicker">取消</button>
        <button class="btn btn-primary" bindtap="saveCity">保存</button>
      </view>
    </view>
  </view>

  <view class="section-title">今日课表</view>
  <view wx:if="{{!loading && courses.length === 0 && !offline && !needSetup && !statusText}}" class="empty">今天没有课，去「课表」页添加吧</view>
  <view wx:for="{{courses}}" wx:key="id" class="card">
    <view class="course-name">{{item.name}}</view>
    <view class="course-meta">{{item.start_time}} - {{item.end_time}}</view>
    <view wx:if="{{item.location}}" class="course-meta">📍 {{item.location}}</view>
    <view wx:if="{{item.teacher}}" class="course-meta">👤 {{item.teacher}}</view>
  </view>

  <block wx:if="{{reminders.length > 0}}">
    <view class="section-title">今日提醒</view>
    <view wx:for="{{reminders}}" wx:key="id" class="card reminder-card">
      <view class="reminder-title">⏰ {{item.title}}</view>
      <view wx:if="{{item.body}}" class="reminder-body">{{item.body}}</view>
      <view class="task-meta">{{item.remindTime}}</view>
    </view>
  </block>

  <view class="section-title">今日待办</view>
  <view wx:if="{{!loading && tasks.length === 0}}" class="empty">没有到期待办，去「日程」页看看吧</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card task-card">
    <checkbox class="task-check" checked="{{item.checked}}" data-id="{{item.id}}" data-done="{{item.done}}" bindtap="toggleTask" />
    <view class="task-body">
      <view class="task-title">{{item.title}}</view>
      <view class="task-meta {{item.overdue ? 'overdue' : ''}}">{{item.overdue ? '已逾期' : '今日截止'}} · {{item.dueText}}</view>
    </view>
  </view>
</view>
