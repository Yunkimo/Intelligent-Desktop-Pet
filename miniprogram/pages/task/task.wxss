.task-card {
  display: flex;
  align-items: center;
}

.task-check {
  margin-right: 16rpx;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
}

.task-title.finished {
  color: #a4b0be;
  text-decoration: line-through;
}

.task-note {
  margin-top: 4rpx;
  color: #747d8c;
  font-size: 24rpx;
}

.task-meta {
  margin-top: 4rpx;
  color: #a4b0be;
  font-size: 24rpx;
}

.badge-overdue {
  margin-right: 8rpx;
  color: #e74c3c;
}

/* 每周固定安排 / 独立提醒：列表里与普通日程区分开 */
.badge-weekly {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #eef4ff;
  color: #3b6fd4;
  font-size: 22rpx;
}

.badge-reminder {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #fff4e6;
  color: #c46a00;
  font-size: 22rpx;
}

.task-actions {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.mini {
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 2;
  margin: 8rpx 0;
}

/* 订阅提醒按钮（绿色描边，与编辑/删除区分） */
.btn-subscribe {
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 2;
  margin: 8rpx 0;
  background: #eefaf1;
  color: #2f9e44;
  border: 1rpx solid #bfe8cc;
}

.remind-meta {
  margin-left: 12rpx;
  color: #2f9e44;
}

/* ===== 一句话创建（C8）===== */
.parse-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  margin-top: 8rpx;
  background: #f5f6f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.parse-failed {
  margin-top: 8rpx;
  color: #e67e22;
  font-size: 24rpx;
}

.draft-modal {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.draft-scroll {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
}

.draft-warning {
  margin: 4rpx 0;
  padding: 8rpx 16rpx;
  background: #fff7e6;
  color: #b7791f;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.draft-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.draft-main {
  flex: 1;
  min-width: 0;
}

.draft-name {
  font-size: 28rpx;
  font-weight: 600;
}

.draft-meta {
  margin-top: 2rpx;
  color: #747d8c;
  font-size: 24rpx;
}

.draft-needs {
  margin-top: 4rpx;
  color: #e67e22;
  font-size: 22rpx;
}

.draft-actions {
  display: flex;
  flex-direction: column;
  margin-left: 12rpx;
}
