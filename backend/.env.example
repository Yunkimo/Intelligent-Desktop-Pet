# 复制本文件为 backend/.env（.env 已被 git 忽略）

# 简单 API Key：桌宠与手机 PWA 调用后端时，请求头 X-API-Key 填这个值
API_TOKEN=change-me-to-a-random-string

# B3 微信渠道：默认关闭，测试使用 Mock，不填写真实凭证。
WX_ENABLED=false
WX_APPID=
WX_SECRET=
WX_TEMPLATE_ID=
# 必须按账号实际模板调整字段名称；thingN 对应 title/body，timeN/dateN 对应 remind_at。
WX_TEMPLATE_FIELDS={"thing1":"title","time2":"remind_at"}
WX_MINIPROGRAM_STATE=developer
WX_TIMEOUT_SECONDS=10
WX_SESSION_TTL_SECONDS=7200
# B4 天气/搜索：免上游 key；目标主机固定，调用者不能指定 URL。
# 超时包括并发槽位等待及完整响应读取；不自动重试，不持久化查询结果。
WEB_QUERY_TIMEOUT_SECONDS=8
WEB_QUERY_MAX_BYTES=262144
WEB_QUERY_MAX_CONCURRENT=4

# 课表图片识别导入：OpenAI 兼容视觉模型（密钥只放后端，不进小程序源码）
# 三个变量全部配置后 /api/courses/parse-image 才可用；留空则接口返回 503
# 注意：DeepSeek 不支持视觉，需另注册硅基流动（cloud.siliconflow.cn，新用户有免费额度）
LLM_API_KEY=change-me-to-a-random-string
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# WebSocket 单连接发送/关闭超时（正有限秒数）
WS_SEND_TIMEOUT_SECONDS=2
WS_CLOSE_TIMEOUT_SECONDS=1

# B2：单 worker 调度。联调可将扫描间隔改为 1 或 2 秒。
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_SEND_TIMEOUT_SECONDS=5
SCHEDULER_LEASE_SECONDS=30
SCHEDULER_RETRY_SECONDS=30
SCHEDULER_MAX_RETRY_SECONDS=300
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_BATCH_SIZE=100
DB_TIMEOUT_SECONDS=2
DB_BACKUP_TIMEOUT_SECONDS=30
# 兼容旧客户端无时区输入：480 分钟为 UTC+8；持久化统一 UTC。
REMINDER_NAIVE_OFFSET_MINUTES=480

# SQLite 数据库路径（默认 backend/data/pet.db，可留空）
# DB_PATH=

# 后续里程碑使用（M4 实时 / M5 手机推送）：
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app   # 内网穿透公网 HTTPS 地址
# VAPID_PRIVATE_KEY=...
# VAPID_PUBLIC_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
