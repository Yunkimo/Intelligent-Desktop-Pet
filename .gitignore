# 密钥与本地数据
.env
data/

# 小程序本地配置（含 API Key，不入库；由 miniprogram/config.example.js 复制而来）
miniprogram/config.js
# 微信开发者工具的个人项目配置（每台机器不同，不入库）
miniprogram/project.private.config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 临时音频
*.mp3
tmp/

# 构建产物
build/
dist/

# 工具缓存与日志
.pytest_cache/
.ruff_cache/
*.log

# 覆盖率产物
.coverage
.coverage.*

# SQLite（默认库在 backend/data/ 下，已被上面的 data/ 忽略；此处兜底自定义 DB_PATH）
*.db
*.db-wal
*.db-shm

# 模型缓存（faster-whisper 下载到用户目录，通常不在仓库内，兜底忽略）
*.pt
*.bin

# Node（小程序端 JS 检查）
node_modules/
