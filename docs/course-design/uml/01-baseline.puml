@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3B5974
skinparam componentBackgroundColor #E8F2FF
skinparam componentBorderColor #507094
skinparam classBackgroundColor #E8F2FF
skinparam classBorderColor #507094
skinparam participantBackgroundColor #E8F2FF
skinparam participantBorderColor #507094
skinparam databaseBackgroundColor #E7F4EF
skinparam NoteBackgroundColor #FFF4DD
skinparam NoteBorderColor #C19548
skinparam TitleFontColor #18344E
!pragma layout smetana
title 图 1　初始系统组件 · b109984
left to right direction
actor 用户 as U
package "桌宠端 A · PyQt6" {
 component "PetWindow\n窗口与输入" as UI
 component "ChatWorker / LLMClient\n对话执行" as Chat
 component "Avatar\n图片 / Live2D" as Avatar
 UI --> Chat
 UI --> Avatar
}
package "后端 B · FastAPI" {
 component "课程 / 日程 / 提醒\nCRUD 路由" as API
 database "SQLite" as DB
 API --> DB : 读写
}
cloud "大模型服务" as LLM
U --> UI
Chat --> LLM : 对话
note bottom of API
  基线已含 REST 接口。
  桌宠接入、调度和小程序在后续提交引入。
end note
@enduml
