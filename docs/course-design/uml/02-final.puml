@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #3B5974
skinparam componentBackgroundColor #E8F2FF
skinparam componentBorderColor #507094
skinparam classBackgroundColor #E8F2FF
skinparam classBorderColor #507094
skinparam participantBackgroundColor #E8F2FF
skinparam participantBorderColor #507094
skinparam databaseBackgroundColor #E7F4EF
skinparam NoteBackgroundColor #FFF4DD
skinparam NoteBorderColor #C19548
skinparam TitleFontColor #18344E
!pragma layout smetana
title 图 2　三端组件与接口 · 课程提交版本
top to bottom direction
package "A　桌宠端" {
 component "PetWindow / Agent" as A
 component "后端适配层\nREST 客户端 / WS 监听" as AC
 A --> AC
}
package "C　微信小程序" {
 component "首页 / 课表 / 日程 / 设置" as C
 component "api.js / session.js / ws.js" as CC
 C --> CC
}
package "B　后端服务" {
 component "FastAPI\n路由与会话鉴权" as API
 component "业务逻辑\n日历 / 解析 / 天气订阅" as Service
 component "推送与调度\nPushService / Scheduler" as S
 database "SQLite\n按用户归属持久化" as DB
 API --> Service
 Service --> DB
 API --> S : 业务变更
 S --> DB : 领取与写回
}
cloud "微信平台" as Wx
cloud "视觉模型 / 天气数据源" as Up
AC --> API : HTTPS
CC --> API : HTTPS
S ..> AC : WSS 事件 / 桌面提醒
S ..> CC : WSS 刷新信号
S --> Wx : 微信通知
Service --> Up : 识别 / 预报
@enduml
