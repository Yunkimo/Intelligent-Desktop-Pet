# DeepSeek / OpenAI 兼容 API 配置
# 复制本文件为 .env 并填入真实值（.env 已被 git 忽略）

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 可选：账户余额查询专用 key
# 仅用于 GET /user/balance 查询账户余额，不参与推理；留空则回退 LLM_API_KEY。
# ACCOUNT_BASE_URL 留空则回退 LLM_BASE_URL，便于用 A 家推理、查 B 家余额。
ACCOUNT_API_KEY=
ACCOUNT_BASE_URL=

# 后端服务（桌宠端调用后端 REST 时使用）
# API_TOKEN 需与 backend/.env 里的 API_TOKEN 保持一致
BACKEND_URL=http://127.0.0.1:8001
API_TOKEN=change-me-to-a-random-string
